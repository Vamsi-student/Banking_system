# MongoDB Connection
# Replace with your MongoDB Atlas URI or local connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# JWT Secret for access tokens (15min) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-random-64-char-hex-string>

# JWT Secret for refresh tokens (7d) — use a DIFFERENT secret
JWT_REFRESH_SECRET=<generate-a-different-64-char-hex-string>

# Email credentials (Gmail App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
